# Optional. You can also connect from Settings in the dashboard.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# For a global API key, use these instead of CLOUDFLARE_API_TOKEN.
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
# Optional override of the session key. Docker persists one automatically in /data.
# Outside Docker, the key and encrypted credentials default to .data/.
SESSION_SECRET=
# Optional paths outside Docker. Keep both files across deployments.
# SESSION_SECRET_FILE=/path/to/data/session.key
# CREDENTIALS_FILE=/path/to/data/credentials.enc
# Local default. For a tunnel, set APP_ORIGIN to your dashboard HTTPS origin.
# Example: APP_ORIGIN=https://dashboard.example.com
# Docker deployment URL and host port.
APP_ORIGIN=http://localhost:3000
DASHBOARD_PORT=3000
BIND_ADDRESS=127.0.0.1
